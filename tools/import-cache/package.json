{
  "name": "@rsc-editor/import-cache",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "rsc-import": "./src/cli.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "import": "node --env-file-if-exists=../../apps/server/.env --import tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@rsc-editor/cache": "workspace:*",
    "@rsc-editor/db": "workspace:*",
    "@rsc-editor/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
