# apps/server configuration. Copy to .env and fill in.
#
# Every value here is validated at boot by src/config.ts -- a missing or
# malformed entry fails the process with a list of everything that is wrong,
# rather than a 500 the first time someone tries to log in.

# development | production | test
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# trace | debug | info | warn | error
LOG_LEVEL=debug

# --- database -------------------------------------------------------------
# Postgres only. The op log's seq allocation and the jsonb definition columns
# both depend on Postgres semantics; pointing this at anything else will not
# work. See docs/DECISIONS.md.
#
# NOTE: no Postgres is running on this machine yet (Docker is not installed --
# docs/DECISIONS.md §8). Nothing that touches the database has been executed
# against a real server; see the api-db handover notes.
DATABASE_URL=postgres://rsc:rsc@localhost:5432/rsc_editor

# --- sessions -------------------------------------------------------------
# Signing key for the session cookie. At least 32 characters, and NOT this
# value in production (config.ts refuses to start if it is).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-32-or-more-random-characters

# Sliding lifetime of a session, in hours. Default 168 (7 days).
SESSION_TTL_HOURS=168

COOKIE_NAME=rsc_session
# Must be true in production (the cookie is useless over plain http anyway).
# Left false here so login works against http://localhost in development.
COOKIE_SECURE=false

# --- origins --------------------------------------------------------------
# Where this server is reachable. The Discord OAuth callback is derived from
# it as ${PUBLIC_URL}/api/auth/discord/callback -- register exactly that URL
# in the Discord application's OAuth2 settings.
PUBLIC_URL=http://localhost:8080

# Where the Vite dev server / built SPA is served from. Used for the CORS
# allow-list and as the post-login redirect target. It is read from config and
# never from the request, so it cannot become an open redirect.
WEB_ORIGIN=http://localhost:5173

# --- discord oauth2 -------------------------------------------------------
# https://discord.com/developers/applications -> your app -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# `identify` is required. `email` is optional: it is stored server-side only
# (never serialised to a client) so an operator can contact an account owner.
# Add `guilds` if you set DISCORD_GUILD_ID below.
DISCORD_SCOPES=identify email

# Optional. When set, only members of this Discord server may sign in.
# Requires `guilds` in DISCORD_SCOPES.
DISCORD_GUILD_ID=
