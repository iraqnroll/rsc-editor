# Copy to .env.development to point the editor at a real server.
#
# WITHOUT this file the app runs against the in-memory mock (`data/mock-api.ts`)
# and needs no backend at all -- that is the default and it is deliberate.
#
# Leave VITE_API_BASE UNSET unless you have a reason not to. vite.config.ts
# proxies /api and /ws to the server, which keeps them same-origin so the
# session cookie travels; setting an absolute base opts out of that. If the
# server is not on the proxy's default port, set RSC_API_PORT for `vite dev`
# instead (e.g. RSC_API_PORT=8090 pnpm dev).
VITE_API_MODE=live

# Optional. Pins the project instead of taking the first the account can see.
# The id is per-database: read it from GET /api/projects.
# VITE_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Optional, and usually wrong -- see above.
# VITE_API_BASE=http://localhost:8090
