{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "@rsc-editor/server#test": {
      "dependsOn": [
        "^build",
        "@rsc-editor/db#test"
      ],
      "outputs": []
    },
    "@rsc-editor/import-cache#test": {
      "dependsOn": [
        "^build",
        "@rsc-editor/server#test"
      ],
      "outputs": []
    }
  }
}
